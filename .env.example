# Supabase (self-hosted on Coolify). Copy to .env and fill in.
# VITE_SUPABASE_URL is the public Kong gateway URL for the stack.
VITE_SUPABASE_URL="https://supabasekong-<service-uuid>.example.com"

# The `anon` JWT generated by the stack (safe to expose - RLS is the real guard).
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key>"

# Retained for tooling compatibility; not used at runtime by the app.
VITE_SUPABASE_PROJECT_ID="<project id>"
